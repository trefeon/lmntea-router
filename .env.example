PORT=3000
# Comma-separated API keys accepted by lmntea-router (hashed at rest, hot reload via atomic.Pointer)
AUTH_TOKENS=sk-lmntea-dev-1,sk-lmntea-dev-2
# Vercel relay auth secret (32B hex via crypto.randomBytes(32).toString('hex')) for Strict Proxy
RELAY_AUTH_SECRET=
# OpenRouter Models API (public, no auth required) — optional override
OPENROUTER_API_URL=https://openrouter.ai/api/v1/models
# Artificial Analysis API v2 key for P6 intelligence sync (https://artificialanalysis.ai/api/v2) — get yours at https://artificialanalysis.ai
ARTIFICIAL_ANALYSIS_API_KEY=
# Upstream provider keys (pattern <PROVIDER>_API_KEY — see src/config/providers.ts)
# Harness gateways
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Regional / aggregators (per-provider PRs — add as needed)
CHUTES_API_KEY=
AI21_API_KEY=
PERPLEXITY_API_KEY=
AIMLAPI_API_KEY=
LOG_LEVEL=info
# Optional: Acerblue upstream base (debug)
# OPENCODE_BASE_URL=https://opencode.ai
